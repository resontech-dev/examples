# Copy this file to .env and fill in your values.
# Loaded by python-dotenv from the cell that calls sdk.login().

# REST API base URL — override for self-hosted / beta deployments
RESONTECH_API=https://api.beta.reson.tech

# Account credentials
RESONTECH_EMAIL=you@example.com
RESONTECH_PASSWORD=your-password

# Garage S3 credentials (Profile → Storage → Provision Bucket / Rotate Key)
RESONTECH_S3_KEY=AKIA...
RESONTECH_S3_SECRET=...
