# Copy to .env and fill in your ResonTech credentials.

# Required — see https://app.reson.tech/account for keys.
RESON_EMAIL=
RESON_PASSWORD=
RESON_S3_KEY=
RESON_S3_SECRET=

# Optional overrides — defaults match the public beta.
# RESON_BASE_URL=https://api.beta.reson.tech
# RESON_S3_ENDPOINT=https://s3.beta.reson.tech

# Optional job knobs — submit.py reads these with sensible defaults.
# NUM_CLIENTS=1
# NUM_ROUNDS=3
# LOCAL_EPOCHS=1
# BATCH_SIZE=64
# LR=1e-3
# JOB_NAME=example-sdk
# QUANTIZATION=float16     # one of: float16 | blockwise8 | float4 | normfloat4 | adaquant
