# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.

# ── Local state (docker-compose defaults) ────────────────────────────────────
PG_DSN=postgresql://bfsi:bfsi@localhost:5432/bfsi
PG_DSN_INGEST=postgresql://ingest_rw:ingest_rw@localhost:5432/bfsi
PG_DSN_AGENT=postgresql://agent_ro:agent_ro@localhost:5432/bfsi
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bfsi

# ── Model endpoints (from the two inference jobs' submit.py output) ──────────
# Stack A — inference_jobs/vllm/Qwen2.5-VL-7B-AWQ_banking_and_insurance_docs_min_8gb_vram
VL_BASE_URL=
VL_API_KEY=
# Stack B — inference_jobs/vllm/Qwen3-8B-AWQ_banking_and_insurance_chat_embed_min_12gb_vram
CHAT_BASE_URL=
CHAT_API_KEY=
# Embeddings live in the SAME Stack B deployment (model id "embed").
# Leave empty → defaults to CHAT_*. Set separately after a second GPU
# splits the stacks — no code changes.
EMBED_BASE_URL=
EMBED_API_KEY=

# ── Agent backend (Module 4/5) ───────────────────────────────────────────────
AGENT_URL=http://localhost:8000
