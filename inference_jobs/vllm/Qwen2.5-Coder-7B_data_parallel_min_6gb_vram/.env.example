# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.

# ── Submit-time (control plane) ──────────────────────────────────────────────
# Platform api key: mint in the dashboard at /profile → Developer
# (rsk_dev_… on beta, rsk_live_… on prod). SDK auth is api-key only.
RESON_API_KEY=
RESON_S3_KEY=
RESON_S3_SECRET=

# ── Predict-time (printed by submit.py once the job is RUNNING) ──────────────
RESON_INFERENCE_URL=
RESON_INFERENCE_API_KEY=
