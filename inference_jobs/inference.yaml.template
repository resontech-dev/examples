# inference.yaml — copy into your job directory and edit.
#
# Two top-level blocks (model, cluster) plus a flat requirements list.
# Everything else is generated by the platform.
#
# Fields the SDK auto-fills if you omit them (defaults shown next to each):
#   cluster.device            → "gpu"
#   cluster.mode              → "data_parallel"
#   cluster.gpus_per_worker   → 1
#   cluster.cpus_per_worker   → 8
# Leave them out unless you want to override.

model:
  # Optional. If set, the file is mounted at /app/model/<basename(path)>
  # inside the container, and predictor.load_weights(local_path) is called
  # once after __init__.
  #
  # Path is relative to the job directory. The platform downloads it from
  # your S3 bucket on the customer's behalf during provisioning, so you
  # don't have to.
  #
  # Common extensions: .pt .pth .onnx .gguf .safetensors .ckpt
  # Leave the whole `path:` line out if the predictor pulls weights from
  # HF Hub / S3 itself inside __init__ (LLM template does this).
  path: "model/your_weights.pt"

  # The Python module under your job dir (without .py) that defines the
  # predictor class. Must match a `<module>.py` file in scripts_dir.
  # Use dotted notation for nested packages, e.g. "predictors.deeplab_serve".
  #
  # The SDK validates this against scripts_dir before upload — typo here
  # and you get an error immediately, not minutes later at replica boot.
  module: "your_module"

  # The class to instantiate. Must satisfy the predictor contract — see
  # README.md ("The predictor contract" section).
  class_name: "YourPredictor"

  # Forwarded verbatim to YourPredictor(**init_args). Put your model's
  # tunables here (num_classes, sampling params, thresholds, ...).
  #
  # CV example:
  init_args:
    num_classes: 3
    chip_size: 512
    confidence_threshold: 0.5
    class_names:
      - "background"
      - "forest"
      - "bushes"
    palette:                     # nested arrays-of-scalars are fine
      - [0, 0, 0]
      - [0, 255, 120]
      - [120, 0, 0]
  #
  # LLM example (transformers / vLLM):
  # init_args:
  #   model_id: "Qwen/Qwen2.5-0.5B-Instruct"
  #   dtype: "auto"
  #   max_input_tokens: 2048
  #   default_max_new_tokens: 256
  #   default_temperature: 0.7
  #   system_prompt: "You are a concise, helpful assistant."

cluster:
  # Replicas to run. Each is a full copy of the model (data_parallel) or one
  # shard group (tensor_parallel). Scale up for throughput.
  num_workers: 1

  # Per-replica backpressure cap. Requests beyond this queue (briefly)
  # then return 503. Keep low for slow models (LLMs: 1–4). Keep higher
  # for fast models (image classifiers: 16–64).
  max_ongoing_requests: 8

  # ── Optional below — SDK fills these in if you omit them ─────────────
  # Uncomment + edit ONLY if you need to override a default.
  #
  # device: "gpu"                # "auto" | "cpu" | "gpu"   (default: "gpu")
  #   # "auto" lets your predictor pick cuda > mps > cpu in __init__.
  #   # "gpu" / "cpu" force a side.
  #
  # mode: "data_parallel"        # "data_parallel" | "tensor_parallel"
  #   # data_parallel  → N replicas, each with a full copy of weights
  #   #                  (best for CV + small/medium models)
  #   # tensor_parallel → 1 replica, weights sharded across N GPUs
  #   #                  (LLMs that don't fit on one GPU; vLLM-backed)
  #
  # gpus_per_worker: 1           # 0 for CPU-only jobs
  # cpus_per_worker: 8

# Pip dependencies installed on top of the base image. Keep tight — every
# entry slows boot. Don't redeclare what the base image already has
# (torch, ray, fastapi, httpx, pillow are present in the base image; check
# templates/base_requirements.txt before adding).
requirements:
  - "your==1.2.3"
  - "deps==4.5.6"

# ─────────────────────────────────────────────────────────────────────────
# Minimal example — equivalent to the above with all optional knobs left
# at their defaults. The SDK fills in device/mode/gpus_per_worker/
# cpus_per_worker automatically before upload.
# ─────────────────────────────────────────────────────────────────────────
#
# model:
#   path: "model/weights.pt"
#   module: "my_serve"
#   class_name: "MyPredictor"
#   init_args:
#     num_classes: 10
#
# cluster:
#   num_workers: 2
#   max_ongoing_requests: 8
#
# requirements:
#   - "torch==2.2.2"
