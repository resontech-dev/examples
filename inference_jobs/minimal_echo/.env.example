# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.

# ── Submit-time credentials (used by sdk_utils/submit.py) ────────────────────
RESON_EMAIL=
RESON_PASSWORD=
RESON_S3_KEY=
RESON_S3_SECRET=

# ── Predict-time endpoint (printed by submit.py once RUNNING; read by sdk_utils/predict.py) ──
RESON_INFERENCE_URL=
RESON_INFERENCE_API_KEY=
