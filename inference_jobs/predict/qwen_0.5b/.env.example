# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.

# ── Submit-time credentials (used by sdk_utils/submit.py) ────────────────────
# Platform API key — mint at Profile → Developer (prefix rsk_live_ / rsk_dev_).
# Auths every control-plane call (submit, list, revoke). NOT the same as the
# predict key returned once the deployment is RUNNING.
RESON_API_KEY=
RESON_S3_KEY=
RESON_S3_SECRET=

# ── Predict-time endpoint (printed by submit.py once RUNNING; read by sdk_utils/predict.py) ──
# Predict API key — opaque token returned by rt_submit_inference(); auths this
# one deployment's POST /predict via the X-API-Key header.
RESON_INFERENCE_URL=
RESON_INFERENCE_API_KEY=

# ── Optional overrides (defaults target the beta environment) ────────────────
# RESON_BASE_URL=https://dev.api.beta.reson.tech
# RESON_S3_ENDPOINT=https://s3.dev.beta.reson.tech
