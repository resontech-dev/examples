# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.

# ── Submit-time (control plane) ──────────────────────────────────────────────
# Platform api key: mint in the dashboard at /profile → Developer
# (rsk_dev_… on beta, rsk_live_… on prod). SDK auth is api-key only.
RESON_API_KEY=
RESON_S3_KEY=
RESON_S3_SECRET=

# ── pack_weights.py only: never shipped with the job ─────────────────────────
# A Hugging Face read token whose account accepted the conditions of
# pyannote/speaker-diarization-community-1.
HF_TOKEN=

# ── Predict-time (printed by submit.py once the job is RUNNING) ──────────────
RESON_INFERENCE_URL=
RESON_INFERENCE_API_KEY=

# ── predict.py --with-whisper: a running Whisper job (its submit.py output) ──
WHISPER_URL=
WHISPER_API_KEY=
# WHISPER_MODEL=whisper

# ── Optional overrides (defaults target the beta environment) ────────────────
# RESON_BASE_URL=https://dev.api.beta.reson.tech
# RESON_S3_ENDPOINT=https://s3.dev.beta.reson.tech
