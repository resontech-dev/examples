# Copy this file to .env and fill in your values.
# Loaded by python-dotenv in the "Connect to ResonTech" cell.

# Platform api key — mint in the dashboard at /profile → Developer
# (rsk_dev_… on beta, rsk_live_… on prod). SDK auth is api-key only.
RESON_API_KEY=

# Garage S3 credentials (Profile → Storage → Provision Bucket / Rotate Key)
RESON_S3_KEY=
RESON_S3_SECRET=

# Optional overrides — defaults target the public beta.
# RESON_BASE_URL=https://api.beta.reson.tech
# RESON_S3_ENDPOINT=https://s3.beta.reson.tech
# RESON_S3_REGION=
# RESON_S3_BUCKET=
# RESON_DASHBOARD_URL=
